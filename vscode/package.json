{
  "name": "el-sol",
  "displayName": "XIX · El Sol — escenarios de prueba con evidencias",
  "description": "Le pasas un caso de desarrollo y arma los escenarios de prueba con Gemini (o una plantilla). Marca cada uno como pasó o falló, adjunta capturas y archivos, automatiza los escenarios con pruebas end-to-end (Playwright para web, Maestro para Android) y genera el informe en PDF.",
  "version": "0.3.3",
  "publisher": "davidsant7e",
  "license": "MIT",
  "icon": "media/icono.png",
  "repository": { "type": "git", "url": "https://github.com/davidsant7e/el-sol" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Testing", "Other"],
  "keywords": ["pruebas", "QA", "casos de prueba", "escenarios", "evidencias", "PDF", "gemini", "checklist", "end-to-end", "e2e", "playwright", "maestro"],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:elsol.nuevo",
    "onCommand:elsol.nuevoDesdeSeleccion",
    "onCommand:elsol.abrir",
    "onCommand:elsol.generarPdf",
    "onCommand:elsol.configurarClave",
    "onCommand:elsol.e2eEjecutar"
  ],
  "contributes": {
    "commands": [
      { "command": "elsol.nuevo", "title": "Nuevo plan de pruebas", "category": "El Sol", "icon": "$(beaker)" },
      { "command": "elsol.nuevoDesdeSeleccion", "title": "Crear plan de pruebas con la selección", "category": "El Sol" },
      { "command": "elsol.abrir", "title": "Abrir plan de pruebas", "category": "El Sol" },
      { "command": "elsol.generarPdf", "title": "Generar el PDF del plan", "category": "El Sol" },
      { "command": "elsol.configurarClave", "title": "Configurar clave de Gemini", "category": "El Sol" },
      { "command": "elsol.e2eEjecutar", "title": "Ejecutar las pruebas end-to-end del plan", "category": "El Sol", "icon": "$(play)" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "elsol.nuevoDesdeSeleccion", "when": "editorHasSelection" }
      ],
      "editor/context": [
        { "command": "elsol.nuevoDesdeSeleccion", "when": "editorHasSelection", "group": "z_elsol@1" }
      ],
      "explorer/context": [
        { "command": "elsol.abrir", "when": "resourceFilename == sol.json", "group": "z_elsol@1" },
        { "command": "elsol.generarPdf", "when": "resourceFilename == sol.json", "group": "z_elsol@2" },
        { "command": "elsol.e2eEjecutar", "when": "resourceFilename == sol.json", "group": "z_elsol@3" }
      ]
    },
    "keybindings": [
      { "command": "elsol.nuevo", "key": "ctrl+alt+shift+t", "mac": "cmd+alt+shift+t" }
    ],
    "configuration": {
      "title": "El Sol",
      "properties": {
        "elsol.carpeta": { "type": "string", "default": "pruebas", "description": "Carpeta del proyecto donde se guardan los planes de prueba (uno por subcarpeta)." },
        "elsol.modelo": { "type": "string", "default": "gemini-3.5-flash-lite", "description": "Modelo de Gemini para armar los escenarios." },
        "elsol.cantidad": { "type": "string", "default": "entre 8 y 15 escenarios", "description": "Cuántos escenarios pedir a Gemini en un plan nuevo." },
        "elsol.abrirPdfAlTerminar": { "type": "boolean", "default": true, "description": "Abrir el PDF en el lector del sistema al generarlo." },
        "elsol.dispositivoAndroid": { "type": "string", "default": "", "markdownDescription": "Número de serie del celular para las pruebas de Android con Maestro (`adb devices`). Hace falta si hay más de un dispositivo conectado. Vacío = usa `ANDROID_SERIAL` o el único conectado." }
      }
    }
  }
}
